#!/data/data/com.termux/files/usr/bin/bash
# resume-item plan                       record that the START HERE plan was posted (session start)
# resume-item <n> done|blocked "<note>"  propose a status; "done" counts only after the operator's #ok <n>
# resume-item status                     show items, proposals and operator marks
# Session id: $CLAUDE_CODE_SESSION_ID, else the newest resume-*.ok in ~/.claude/state.
st="$HOME/.claude/state"
sid=${CLAUDE_CODE_SESSION_ID:-$(ls -t "$st"/resume-*.ok 2>/dev/null | head -1 | sed 's|.*/resume-||; s|\.ok$||')}
[ -n "$sid" ] || { echo "no session found" >&2; exit 1; }
snap="$st/resume-$sid.snap.md"; items="$st/resume-items-$sid.tsv"; marks="$st/confirm-$sid.tsv"
list() { awk '/^#+ .*START HERE/{f=1;next} f&&/^#/{exit} f&&/^[0-9]+\. /' "${snap:-/dev/null}" 2>/dev/null; }
case ${1:-} in
  plan)
    [ -f "$snap" ] || { echo "no session-start RESUME snapshot for $sid" >&2; exit 1; }
    list > "$st/plan-$sid.txt"; echo "plan recorded ($(wc -l < "$st/plan-$sid.txt") items) — waiting for operator #ok / #defer:"; cat "$st/plan-$sid.txt" ;;
  status)
    list | while IFS= read -r l; do n=${l%%.*}
      p=$(grep "^$n	" "$items" 2>/dev/null | cut -f2,3 | tr '\t' ' '); m=$(grep "^$n	" "$marks" 2>/dev/null | tail -1 | cut -f2)
      echo "$n. proposed: ${p:-—} | operator: ${m:-—}"; done ;;
  *)
    [ $# -eq 3 ] && [[ $1 =~ ^[0-9]+$ ]] && [[ $2 =~ ^(done|blocked)$ ]] && [ -n "$3" ] \
      || { sed -n 2,4p "$0" >&2; exit 1; }
    grep -v "^$1	" "$items" 2>/dev/null > "$items.tmp"; printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$items.tmp"; mv "$items.tmp" "$items"
    echo "item $1: proposed $2 — $3 (needs operator #ok $1)" ;;
esac
