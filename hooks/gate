#!/usr/bin/env bash
# Operator kill switch for hooks. Works mid-session, no restart, no settings edit.
#   gate off <name>|all   gate on <name>|all   gate status
off="$HOME/.claude/state/off"; mkdir -p "$off"
names="resume-gate checkin-gate secret-guard settings-guard state-guard branch-current-gate enforce-gate stop-gate absence-gate session-ledger archive-scratchpad ship-session"
case "$1" in
  off) if [ "$2" = all ]; then for n in $names; do touch "$off/$n"; done; else touch "$off/${2%.sh}"; fi; echo "off: ${2:-?}";;
  on)  if [ "$2" = all ]; then rm -f "$off"/*; else rm -f "$off/${2%.sh}"; fi; echo "on: ${2:-?}";;
  status) for n in $names; do [ -e "$off/$n" ] && echo "OFF  $n" || echo "on   $n"; done;;
  *) echo "usage: gate off|on <name>|all ; gate status"; exit 1;;
esac
