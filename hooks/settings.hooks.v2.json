{
  "hooks": {
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh resume-gate", "timeout": 10}]},
      {"matcher": "*", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh checkin-gate", "timeout": 10}]},
      {"matcher": "*", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh enforce-gate", "timeout": 10}]},
      {"matcher": "Bash|Read", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh secret-guard", "timeout": 10}]},
      {"matcher": "Bash|Edit|Write", "hooks": [
        {"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh settings-guard", "timeout": 10},
        {"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh state-guard", "timeout": 10},
        {"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh branch-current-gate", "timeout": 30}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|Bash", "hooks": [{"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh session-ledger", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [
        {"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh stop-gate", "timeout": 20},
        {"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh absence-gate", "timeout": 10}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh archive-scratchpad", "timeout": 60}]}
    ],
    "SessionEnd": [
      {"hooks": [
        {"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh archive-scratchpad", "timeout": 60},
        {"type": "command", "command": "bash ~/.claude/hooks/run-gate.sh ship-session", "timeout": 30}]}
    ]
  }
}
