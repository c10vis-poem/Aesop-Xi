{
  "disableAllHooks": false,
  "extraKnownMarketplaces": {
    "novaexopia": {
      "source": {
        "source": "github",
        "repo": "c10vis-poem/NovAExopia",
        "ref": "main"
      }
    },
    "nvaex-vault": {
      "source": {
        "source": "github",
        "repo": "c10vis-poem/NovAExorpus",
        "ref": "main"
      }
    },
    "aesop-xi": {
      "source": {
        "source": "directory",
        "path": "/data/data/com.termux/files/home/repos/Aesop-Xi"
      }
    }
  },
  "enabledPlugins": {
    "nvaex-jev-core@novaexopia": true,
    "nvaex-memory@novaexopia": true,
    "nvaex-rea-forge@novaexopia": true,
    "nvaex-burn@novaexopia": true,
    "claw-mcp@novaexopia": true,
    "nvaex-ui-cockpit@novaexopia": true,
    "greedy-crane@nvaex-vault": true,
    "aesops-enforcements@aesop-xi": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); export CLAUDE_SESSION_ID=$(printf '%s' \"$input\" | jq -r '.session_id // empty'); printf '%s' \"$input\" | node \"${CLAUDE_PLUGIN_ROOT:-$HOME/.claude/plugins/cache/ecc/ecc/2.2.0}/scripts/hooks/session-activity-tracker.js\" 2>/dev/null || true",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "Real, per-tool-call usage log to ~/.claude/metrics/tool-usage.jsonl -- best-effort, needs ECC installed in this session (attach ECC-aesop) to actually record."
      }
    ]
  }
}
