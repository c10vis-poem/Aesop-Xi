{
  "description": "Contract enforcement: one gate, one stop gate, one ledger.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/lib/hook.py",
              "SessionStart"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/lib/hook.py",
              "UserPromptSubmit"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/lib/hook.py",
              "PreToolUse"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/lib/hook.py",
              "PostToolUse"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/lib/hook.py",
              "Stop"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/lib/hook.py",
              "SubagentStart"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PLUGIN_ROOT}/lib/hook.py",
              "SubagentStop"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}