#!/bin/sh
[ -n "$BASH_VERSION" ] || exec bash "$0" "$@"   # /usr/bin/env is absent on Termux without termux-exec
# The housekeeping workflow.
#   housekeeping report   read-only: writes ~/.claude/state/housekeeping/<date>.md and prints its path
#   housekeeping done     sets last-housekeeping: in PENDING.md to today (only after the routines ran)
# Nothing here deletes, merges, pushes or changes a repo. Those go through the operator (/housekeeping).
root=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)
. "$root/scripts/lib/env.sh"
P=${PENDING_FILE:-${VAULT:-/nonexistent}/PENDING.md}
case ${1:-report} in
  done)
    [ -f "$P" ] || { echo "housekeeping: no PENDING.md at $P" >&2; exit 1; }
    if grep -q '^last-housekeeping:' "$P"; then sed -i -E "s/^last-housekeeping:.*/last-housekeeping: $(date +%F)/" "$P"
    else printf 'last-housekeeping: %s\n' "$(date +%F)" >> "$P"; fi
    echo "last-housekeeping: $(date +%F)"; exit 0 ;;
  report) ;;
  *) echo "usage: housekeeping report|done" >&2; exit 1 ;;
esac
d=$ST/housekeeping; mkdir -p "$d"; o=$d/$(date +%F).md; t=$o.tmp
cutoff=$(date -d '30 days ago' +%F)
{
  echo "# Housekeeping report $(date '+%F %H:%M')"
  echo; echo "Read-only. Last done: $(sed -n 's/^last-housekeeping: *//p' "$P" 2>/dev/null | head -1)"

  echo; echo "## 1. Recaps older than 30 days (by the date in the file name; roll into a monthly summary)"
  for dir in "${VAULT:-/nonexistent}/_recaps" "$RECAPS_DIR"; do
    [ -d "$dir" ] || continue
    n=$(find "$dir" -maxdepth 1 -name '20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]*' -printf '%f\n' 2>/dev/null | awk -v c="$cutoff" 'substr($0,1,10) < c' | wc -l)
    echo "- $dir: $n"
  done

  echo; echo "## 2. Repos: uncommitted, unpushed, stray branches, open PRs"
  for n in ${HOUSEKEEPING_REPOS:-Aesop-Xi NovAExopia NovusAExenti Hyperion-XI AEthX-AEsc CloviX-AEyre NvAEx-Recaps}; do
    r=$HOME/repos/$n
    [ -d "$r/.git" ] || { echo "- $n: NOT CHECKED, no checkout at $r"; continue; }
    timeout 30 git -C "$r" fetch -q origin 2>/dev/null || echo "- $n: fetch failed, remote state may be stale"
    dirty=$(git -C "$r" status --porcelain 2>/dev/null | wc -l)
    un=$(git -C "$r" for-each-ref --format='%(refname:short)' refs/heads | while read -r b; do
      [ -n "$(git -C "$r" log -1 --format=%H "refs/heads/$b" --not --remotes 2>/dev/null)" ] && echo "$b"; done)
    rb=$(git -C "$r" for-each-ref --format='%(refname:short)' refs/remotes/origin | grep -vE '^origin(/HEAD|/main|/master)?$' | wc -l)
    wt=$(git -C "$r" worktree list 2>/dev/null | wc -l)
    pr=$(ghq pr list -R "c10vis-poem/$n" --state open --json number --jq length); pr=${pr:-unknown}
    echo "- $n: $dirty uncommitted; $(grep -c . <<<"$un") unpushed branch(es)${un:+: $(paste -sd' ' <<<"$un")}; $rb other remote branch(es); $wt worktree(s); $pr open PR(s)"
  done

  echo; echo "## 3. Task-observer log"
  so=${VAULT:-/nonexistent}/skill-observations
  if [ -d "$so" ]; then
    echo "- open: $(grep -lE '^status:[[:space:]]*"?open' "$so"/observation-log/[0-9]*.md 2>/dev/null | wc -l); last review: $(head -1 "$so/last-review-date.txt" 2>/dev/null)"
  else echo "- NOT CHECKED: no skill-observations here"; fi

  echo; echo "## 4. Cloud billing"
  if command -v gcloud >/dev/null 2>&1; then
    out=$(timeout 45 gcloud compute instances list --filter=status=RUNNING --format='value(name,zone)' 2>&1) && echo "- running VMs: ${out:-none}" || echo "- NOT CHECKED: gcloud failed"
  else echo "- NOT CHECKED: no gcloud on this device. The operator checks the billing page."; fi

  echo; echo "## 5. Builder reminders in PENDING.md"
  sed -n '/^## Routines/,/^## /{/^- /p}' "$P" 2>/dev/null
} > "$t"
mv "$t" "$o"; echo "$o"
