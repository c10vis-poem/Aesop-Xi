#!/bin/sh
[ -n "$BASH_VERSION" ] || exec bash "$0" "$@"   # /usr/bin/env is absent on Termux without termux-exec
# asset-manifest <path>   Rule 12: write the manifest for an asset so later sessions read it by pointer.
#   A repo (~/repos/<name>, a fork not yet reverse-engineered): writes the vault's Assets-Index/<name>/
#     POINTER.md (origin, local path, HEAD) and manifest.jsonl. Analyzed doc partitions go in that same folder.
#   A vendor folder (vault Vendor-Registries/<vendor>): writes manifest.jsonl inside it, next to the raw files.
# manifest.jsonl: line 1 {"asset","source","head","built"}; then one line per file:
#   {"path","bytes","sha256","doc":true|false,"headings":[first 8 Markdown headings]}.
# Build it only after reading the asset in full (Rule 12): the manifest is for finding parts later, not a
# substitute for reading them. The vault is PUBLIC: never build one for a private repo's contents.
# Env: VAULT, ASSETS_INDEX (Assets-Index), VENDOR_DIR (Vendor-Registries).
set -u
src=$(realpath -m "${1:?usage: asset-manifest <repo or vendor folder>}"); [ -d "$src" ] || { echo "not a folder: $src" >&2; exit 1; }
V=${VAULT:-$HOME/storage/shared/Documents/NovAExorpus}; VR="$V/${VENDOR_DIR:-Vendor-Registries}"; AI="$V/${ASSETS_INDEX:-Assets-Index}"
name=${src##*/}; head=$(git -C "$src" rev-parse HEAD 2>/dev/null || true)
case $src in
  "$VR"/*) out="$src/manifest.jsonl"; kind=vendor ;;
  *) out="$AI/$name/manifest.jsonl"; kind=repo
     url=$(git -C "$src" remote get-url origin 2>/dev/null || true)
     u=${url%.git}; vis=$(gh repo view "${u#*github.com[:/]}" --json visibility -q .visibility 2>/dev/null || echo unknown)
     [ "$vis" = PRIVATE ] && { echo "refused: $name is a private repo; the vault is public" >&2; exit 1; } ;;
esac
mkdir -p "${out%/*}"
files() { if [ -n "$head" ]; then git -C "$src" ls-files; else ( cd "$src" && find . -type f -not -path './.git/*' -not -name manifest.jsonl | sed 's|^\./||' ); fi; }
{
  jq -cn --arg a "$name" --arg s "$src" --arg h "$head" --arg b "$(date '+%F %T')" '{asset:$a,source:$s,head:$h,built:$b}'
  files | sort | while IFS= read -r f; do
    p="$src/$f"; [ -f "$p" ] || continue
    doc=false; hd='[]'
    case $f in *.md|*.mdx|*.rst|*.txt|README*|INSTALL*|CHANGELOG*) doc=true
      hd=$(grep -m8 -E '^#{1,4} ' "$p" 2>/dev/null | jq -Rcs 'split("\n")|map(select(length>0))') ;; esac
    jq -cn --arg p "$f" --argjson b "$(stat -c %s "$p")" --arg h "$(sha256sum "$p" | cut -d' ' -f1)" --argjson d "$doc" --argjson hd "$hd" \
      '{path:$p,bytes:$b,sha256:$h,doc:$d,headings:$hd}'
  done
} > "$out.tmp" && mv "$out.tmp" "$out"
if [ "$kind" = repo ]; then
  cat > "${out%/*}/POINTER.md" <<EOF
# $name

- Kind: fork, not yet reverse-engineered (Rule 12 pointer)
- Origin: ${url:-none}
- Local: $src
- HEAD at manifest build: ${head:-none}
- Manifest: manifest.jsonl (this folder). Analyzed doc partitions live in this folder too.
EOF
fi
echo "$out ($(($(wc -l < "$out") - 1)) files)"
