#!/bin/sh
[ -n "$BASH_VERSION" ] || exec bash "$0" "$@"   # /usr/bin/env is absent on Termux without termux-exec
# Operator switch for the aesops-enforcements hooks. Works mid-session, no restart, no settings edit.
#   gate off <hook>|all    gate on <hook>|all    gate status
# Agents cannot run off/on: state-guard blocks it (RULES.md rule 4). Operator: `! gate off <hook>`.
root=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd); here=$root/scripts; pkg=aesops-enforcements
st=${STATE_DIR:-$HOME/.claude/state}; off=$HOME/.claude/state/off; mkdir -p "$off"
names=$(awk -F'\t' '!/^#/{print $3}' "$here/gates.tsv" 2>/dev/null | awk '!s[$0]++')
known() { grep -qxF "$1" <<<"$names" || { echo "gate: no hook named $1. Hooks: $(paste -sd' ' <<<"$names")" >&2; exit 1; }; }
case "$1" in
  off) [ -n "$2" ] || { echo "usage: gate off <hook>|all" >&2; exit 1; }
       if [ "$2" = all ]; then touch "$off/$pkg"; else known "${2%.sh}"; touch "$off/${2%.sh}"; fi; echo "off: $2" ;;
  on)  [ -n "$2" ] || { echo "usage: gate on <hook>|all" >&2; exit 1; }
       if [ "$2" = all ]; then
         rm -f "${off:?}/${pkg:?}" "${off:?}/${pkg:?}".* "$HOME/.nvaex-hooks-off" "${st:?}/hooks-off"
         for n in $names; do rm -f "${off:?}/${n:?}"; done
       else known "${2%.sh}"; rm -f "${off:?}/${2%.sh}" "${off:?}/${pkg:?}.${2%.sh}"; fi
       echo "on: $2" ;;
  status)
    bad=0
    [ -e "$HOME/.nvaex-hooks-off" ] && echo "KILL SWITCH ~/.nvaex-hooks-off is set: every hook is off"
    [ -e "$off/$pkg" ] && echo "KILL SWITCH $off/$pkg is set: every hook is off"
    [ -e "$st/hooks-off" ] && echo "MASTER SWITCH is off (#hooks-off): every hook is off until #hooks-on"
    command -v jq >/dev/null 2>&1 || { echo "MISSING jq: no hook can run here"; bad=1; }
    for f in "$HOME/.claude/settings.json" "$HOME/.claude/settings.local.json" "$HOME"/repos/*/.claude/settings.json "$HOME"/repos/*/.claude/settings.local.json; do
      [ -f "$f" ] && jq -e '.disableAllHooks==true' "$f" >/dev/null 2>&1 && { echo "HOOKS KILLED: $f sets disableAllHooks true; every hook is off when launched there"; bad=1; }
    done
    for n in $names; do
      if [ ! -f "$here/$n.sh" ]; then echo "MISSING $n ($here/$n.sh)"; bad=1
      elif [ -e "$off/$n" ] || [ -e "$off/$pkg.$n" ]; then echo "OFF  $n"
      else echo "on   $n"; fi
    done
    [ -s "$st/gate-missing" ] && { echo "reported missing while running: $(sort -u "$st/gate-missing" | paste -sd' ')"; bad=1; }
    l=$st/hooks.log
    if [ -f "$l" ]; then
      for w in MISSING ERROR CRASH TIMEOUT LOOP-BREAKER DEGRADE; do
        c=$(grep -cE "^[0-9-]+ [0-9:]+ ([a-z-]+ )?$w" "$l"); [ "$c" -gt 0 ] && echo "$w: $c line(s) in $l"; done
      grep -E '^[0-9-]+ [0-9:]+ ([a-z-]+ )?(MISSING|ERROR|CRASH|TIMEOUT|LOOP-BREAKER)' "$l" | tail -5 | cut -c1-160
    fi
    exit $bad ;;
  *) echo "usage: gate off|on <hook>|all ; gate status" >&2; exit 1 ;;
esac
